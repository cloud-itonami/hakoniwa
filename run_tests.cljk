(require '[kotoba.test :as t])
(def suites '[hakoniwa.tests.test-distribution hakoniwa.tests.test-distribution-entropy
              hakoniwa.tests.test-ingest hakoniwa.tests.test-runtime
              hakoniwa.tests.test-simulate hakoniwa.murakumo-test
              hakoniwa.repository-contract-test])
(apply require suites)
(let [{:keys [fail error] :as r} (apply t/run-tests suites)]
  (println (select-keys r [:test :pass :fail :error]))
  (when (pos? (+ fail error)) (System/exit 1)))
